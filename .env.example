# Supabase Postgres
#
# Use the DIRECT connection (port 5432) only for running migrations:
#   psql "$DATABASE_URL_DIRECT" -f infra/migrations/0001_init.sql
DATABASE_URL_DIRECT=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Use the POOLED connection (port 6543) for pipeline + engine at runtime.
# Supabase exposes this via the Session/Transaction pooler hostname.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Google Places API (New) — needed by pipeline/discover.py
# Restrict the key to the Places API in Google Cloud Console.
GOOGLE_PLACES_API_KEY=
